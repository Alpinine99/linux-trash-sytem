#! /usr/bin/bash

help="\
\e[1mDetails:\e[0m
    This is a trash/restore tool
\e[1mUsage:\e[0;33m
    get logs: $0 -l
    trash file: $0 <file> <file> ...
    restore file: $0 -r <file/folder name>
    restore to custom path: $0 -p <custom path> -r <file/folder name>
    empty trash: $0 -e <date/'now'> <up/down>
                 $0 -e \"Fri Mar  6 11:57:43 PM EAT 2026\" up      # deletes from set date up
                 $0 -e \"Fri Jan  6 12:57:43 PM EAT 2026\" down    # deletes from set date down

\e[0;1mDocumentation and examples:\e[0;33m
    Check out \e[4;1mhttps://github.com/Alpinine99/trashing-recovery-system.git\e[0m for more.
"

TRASH=true
LOG=false
R_FILE=""
E_DATE=""
R_PATH=""
while getopts 'h?lr:e:p:' opt; do
    case "$opt" in
        h) printf "$help"; exit 0;;
        l) LOG=true;;
        r) R_FILE=$OPTARG;;
        e) E_DATE="$OPTARG";;
        p) R_PATH=$OPTARG;;
    esac
    TRASH=false
done
shift $((OPTIND - 1))

BIN_PATH="$HOME/.local/.trash"
LOG_FILE="$BIN_PATH/.trashing.log"

trash() {
    mkdir -p $BIN_PATH
    [ ! -f $LOG_FILE ] && touch $LOG_FILE
    local error="\e[31;1mE - missing:"
    for file in "$@"; do
        [ ! -e "$file" ] && error="$error $file" && continue
        file=$(realpath $file)
        local trashFile=$file
        while [ -e $trashFile ]; do
            trashFile="$BIN_PATH/`< /dev/urandom tr -dc 'A-Za-z0-9' | head -c 15`"
        done
        mv $file $trashFile
        [ -d $trashFile ] && file="$file/"
        echo "[`date`] $file:$trashFile" >> $LOG_FILE
        chmod 440 -R $trashFile
    done
    [ "$error" = "\e[31;1mE - missing:" ] && return 0
    echo -e "\a$error\e[0m (else remove spaces on file name)" >&2
    return 1 
}

log() {
    [ ! -f $LOG_FILE ] && echo -e "\e[33;1mW - No logs available\e[0m" >&2 && return 0
    tac $LOG_FILE | tr -d '[' | cut -d: -f1,2,3 | column -t -s ] -N "DATE TRASHED"," FILE NAME" | less
}

restore() {
    [ ! -f $LOG_FILE ] && echo -e "\e[33;1mW - Nothing to restore, else confirm log file\e[0m" >&2 && return 0
    if [ -n "$R_PATH" ]; then
        R_PATH=$(realpath $R_PATH 2>/dev/null)
        [ -z "$R_PATH" ] && echo -e "\e[31;1mE - Invalid recovery path!\e[0m" >&2 && return 1
    fi

    local TARGET_FILES=($(cut -d] -f2 $LOG_FILE | cut -d: -f1 | tr ' ' '\n' | grep -E "(/$R_FILE$|/$R_FILE/$)"))
    [ -z "$TARGET_FILES" ] && echo -e "\e[31;1mE - File '$R_FILE' not found, else confirm log file\e[0m" >&2 && return 1 

    if [ ${#TARGET_FILES[@]} -ne 1 ]; then
        local CHOICES=()
        for TARGET in ${TARGET_FILES[@]}; do
            CHOICES[${#CHOICES[@]}]="$(cut -d: -f1,2,3 $LOG_FILE | grep -e "$TARGET$" | tr ' ' '_')"
        done
        select TARGET in ${CHOICES[@]}; do
            [ -n "$TARGET" ] && TARGET_FILES="$(echo $TARGET | tr '[]' '%')" && break
        done
    else
        TARGET_FILES="${TARGET_FILES[0]}"
    fi
    local FILE=$(cat $LOG_FILE | tr ' ' '_' | tr '[]' '%' | grep "$TARGET_FILES" | cut -d: -f4)
    local REAL_PATH="$(cat $LOG_FILE | grep "$FILE" | cut -d] -f2 | cut -d: -f1 | tr -d ' ')"
    [ -d $FILE ] && REAL_PATH="${REAL_PATH%?}"
    [ -z "$R_PATH" ] && R_PATH="${REAL_PATH%/*}"
    FILE_NAME="${REAL_PATH##*/}"
    [ -f $R_PATH ] && echo -e "\e[31;1mE - File '$R_PATH' conficts, specify recovery path!\e[0m" >&2 && return 1
    [ ! -d $R_PATH ] && mkdir -p $R_PATH
    chmod 664 $FILE
    mv $FILE $R_PATH/$FILE_NAME
    echo -e "\e[32;1mI - Recovered to '$R_PATH'\e[0m"
    local LINE_NUMBER=$(grep -n "$FILE" $LOG_FILE | cut -d: -f1)
    sed -i "${LINE_NUMBER}d" $LOG_FILE
    return 0
}

empty() {
    [ ! -f $LOG_FILE ] && echo -e "\e[33;1mW - Nothing to clean!\e[0m" >&2 && return 0
    # Fri Mar  6 11:57:43 PM EAT 2026
    if ! echo "$E_DATE" | grep -E -q '^[A-Z][a-z]{2} [A-Z][a-z]{2} [ ]?[0-9]{1,2} [0-9]{2}:[0-9]{2}:[0-9]{2} [AP]M [A-Z]{3} [0-9]{4}$' && [ "$E_DATE" != "now" ]; then
        echo -e "\e[31;1mE - Invalid date format!\e[0m" >&2
        return 1
    fi
    [ -z "$1" ] && FILTER="down" || FILTER="$1"
    if [ "$E_DATE" = "now" ]; then
        local EPOCH=$EPOCHSECONDS
    else
        local EPOCH=$(date -d "$E_DATE" +%s 2>&1)
        [ -n "$(echo "$EPOCH" | grep "invalid")" ] && echo -e "\e[31;1mE - Invalid date (unreal date)!\e[0m" >&2 && return 1
    fi
    [ $EPOCH -gt $EPOCHSECONDS ] && echo -e "\e[31;1mE - Invalid date (future date)!\e[0m" >&2 && return 1
    if [ "$E_DATE" = "now" ]; then
        rm -rf $BIN_PATH/*
        rm -rf $LOG_FILE
        printf "\033[32;1mI - Everything cleared in trash!\033[0m\n"
    else
        local N_FILES=0
        while read -r LOG; do
            local C_EPOCH=$(date -d "$(echo "$LOG" | cut -d[ -f2 | cut -d] -f1)" +%s)
            local FILE=$(echo "$LOG" | cut -d: -f4)
            if [ "$FILTER" == "down" ]; then
                if ((C_EPOCH <= EPOCH)); then
                    rm -rf $FILE
                    local LINE_NUMBER=$(grep -n "$FILE" $LOG_FILE | cut -d: -f1)
                    sed -i "${LINE_NUMBER}d" $LOG_FILE
                    ((N_FILES++))
                fi
            else
                if ((C_EPOCH >= EPOCH)); then
                    rm -rf $FILE
                    local LINE_NUMBER=$(grep -n "$FILE" $LOG_FILE | cut -d: -f1)
                    sed -i "${LINE_NUMBER}d" $LOG_FILE
                    ((N_FILES++))
                fi
            fi
        done < "$LOG_FILE"
        printf "\033[32;1mI - $N_FILES files cleared in trash!\033[0m\n"
    fi
    return 0
}

if $TRASH; then
    if [ $# -eq 0 ]; then
        printf "\033[31;1mE - Missing input!\033[0m\n"
        printf "$help"
        exit 1
    fi
    trash $@
    exit $?
elif $LOG; then
    log
    exit 0
elif [ -n "$R_FILE" ]; then
    restore
    exit $?
elif [ -n "$E_DATE" ]; then
    empty $@
    exit $?
fi
